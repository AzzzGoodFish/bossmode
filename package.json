{
  "name": "bossmode",
  "version": "0.19.0",
  "description": "Discord-style AI team chat room",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzzzGoodFish/bossmode.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agent",
    "team",
    "chat",
    "bossmode"
  ],
  "files": [
    "dist",
    "templates",
    "web/dist",
    "vendor/pi-mcp-adapter/*.ts",
    "!vendor/pi-mcp-adapter/*.test.ts",
    "!vendor/pi-mcp-adapter/vitest.config.ts",
    "vendor/pi-mcp-adapter/*.js",
    "!vendor/pi-mcp-adapter/package.json",
    "vendor/pi-mcp-adapter/LICENSE",
    "vendor/pi-mcp-adapter/README.md"
  ],
  "bin": {
    "bossmode": "./dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && chmod +x dist/cli/index.js && cd web && npm run build",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "open": "^11.0.0",
    "recheck": "^4.5.0",
    "typebox": "^1.1.39",
    "ws": "^8.18.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}