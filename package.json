{
  "name": "bossmode",
  "version": "0.13.6",
  "description": "Discord-style AI team chat room",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzzzGoodFish/bossmode.git"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "ai",
    "agent",
    "team",
    "chat",
    "bossmode"
  ],
  "files": [
    "dist",
    "templates",
    "web/dist"
  ],
  "bin": {
    "bossmode": "./dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && chmod +x dist/cli/index.js && cd web && npm run build",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.79.1",
    "@earendil-works/pi-coding-agent": "^0.79.1",
    "typebox": "^1.1.39",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
