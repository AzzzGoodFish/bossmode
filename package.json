{
  "name": "bossmode",
  "version": "0.1.3",
  "description": "Discord-style AI team chat room",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzzzGoodFish/bossmode.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "team",
    "chat",
    "bossmode",
    "mcp",
    "claude"
  ],
  "files": [
    "dist",
    "templates",
    "web/dist"
  ],
  "bin": {
    "bossmode": "./dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ws": "^8.18.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
